# ---- LLM (default provider: Google Gemini, free tier) ----
GEMINI_API_KEY=
# Max LLM requests per minute (rolling 60s window, shared across all sources + retries).
# Keep at/below your provider's RPM limit. Gemini 2.5 Flash free tier = 5 RPM.
LLM_MAX_RPM=5

# ---- Email / SMTP (used by nodemailer for the daily digest) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Server ----
PORT=3000

# ---- Scheduler ----
# Timezone for the 08:00 daily digest cron job (IANA name, e.g. "UTC", "America/New_York", "Europe/Berlin").
DIGEST_TIMEZONE=UTC
# Cron expression for the digest (defaults to every day at 08:00). Leave as-is for 8 AM.
DIGEST_CRON=0 8 * * *

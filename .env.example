# ---- Database (libSQL / Turso) ----
# Leave BLANK for local dev: a file-backed DB is auto-created under data/.
# For production (Vercel): set the libsql:// URL + auth token from your Turso DB.
DATABASE_URL= 
DATABASE_AUTH_TOKEN= 

# ---- Secrets ----
# 32-byte base64 or hex. REQUIRED in production so saved custom API keys stay
# decryptable across serverless instances (locally an ephemeral key is used if unset).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_SECRET=
# Shared secret guarding /api/cron/digest (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ---- LLM (default provider: Google Gemini, free tier) ----
GEMINI_API_KEY=
# Max LLM requests per minute (rolling 60s window, shared across all sources + retries).
# Keep at/below your provider's RPM limit. gemini-3.1-flash-lite allows >=10 RPM;
# higher values let the weekly digest job (sources + cross-source = ~6 calls) finish
# within Vercel's 60s function limit. Gemini 2.5 Flash free tier is only 5 RPM.
LLM_MAX_RPM=10

# ---- Email / SMTP (used by nodemailer for the weekly digest) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Server ----
PORT=3000

# ---- Scheduler ----
# Timezone for the weekly digest cron job, sent Tuesdays at 09:00 (IANA name, e.g. "UTC", "America/New_York", "Europe/Berlin").
DIGEST_TIMEZONE=UTC
# Cron expression for the digest (defaults to every Tuesday at 09:00). Leave as-is for 9 AM Tuesday.
DIGEST_CRON=0 9 * * 2
# Only summarize articles published within this many hours (default: 7 days, to match the weekly digest).
# Set to 0 to disable and use the latest items regardless of date.
DIGEST_LOOKBACK_HOURS=168
